# Copy to .env and fill in. NEVER commit .env.
# Full explanation of every variable: docs/02-data-model.md

# ── Core ─────────────────────────────────────────────────────────────
FOMO_ENV=development
FOMO_LOG_LEVEL=INFO
FOMO_TRADING_MODE=paper            # paper | live
FOMO_LIVE_CONFIRMED=false          # second, deliberately awkward switch (see below)
FOMO_WEIGHTS_VERSION=v1

# ── Database & cache (phase 1+) ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fomo:fomo@localhost:5432/fomo
REDIS_URL=redis://localhost:6379/0

# ── Blockchain — READ-ONLY keys only ─────────────────────────────────
SOLANA_RPC_URL=
SOLANA_RPC_WS_URL=
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=             # HMAC verification of inbound webhooks

# ── Market & token data ──────────────────────────────────────────────
BIRDEYE_API_KEY=
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# ── Token security ───────────────────────────────────────────────────
RUGCHECK_API_KEY=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# ── Social ───────────────────────────────────────────────────────────
X_BEARER_TOKEN=
X_API_TIER=basic

# ── AI ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
FOMO_LLM_MODEL=claude-sonnet-5
FOMO_LLM_MAX_DAILY_USD=25          # on breach the classifier falls back to heuristics

# ── Alerts ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── API / dashboard ──────────────────────────────────────────────────
FOMO_API_HOST=127.0.0.1            # do not bind 0.0.0.0 without auth in front
FOMO_API_PORT=8000
FOMO_JWT_SECRET=
FOMO_CORS_ORIGINS=http://localhost:3000

# ── Paper trading ────────────────────────────────────────────────────
FOMO_PAPER_START_EQUITY_USD=10000
FOMO_PAPER_MAX_POSITION_PCT=5
FOMO_PAPER_MAX_CONCURRENT=8
FOMO_PAPER_MAX_DAILY_LOSS_PCT=15

# ── Live trading ─────────────────────────────────────────────────────
# Intentionally absent. Live execution runs as a SEPARATE service on a SEPARATE host
# with its key in KMS (docs/01 §7). No private key ever belongs in this file.
